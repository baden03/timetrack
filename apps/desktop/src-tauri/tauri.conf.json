{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeTrack",
  "version": "0.1.0",
  "identifier": "de.twinpictures.timetrack",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "TimeTrack", "width": 720, "height": 480 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/icon.png"]
  }
}
